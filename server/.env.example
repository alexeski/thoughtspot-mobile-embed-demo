# Copy to .env and fill in. Never commit .env.
TS_HOST=https://se-thoughtspot-cloud.thoughtspot.cloud
TS_USERNAME=your.user@example.com

# Option A (recommended): trusted auth secret key
# Develop → Customizations → Security settings → Trusted authentication
TS_SECRET_KEY=

# Option B (demo only): the user's password. Ignored if TS_SECRET_KEY is set.
# Does not work if MFA is enabled for the user.
TS_PASSWORD=

# Optional: Org to log in to (0 = Primary). A secret key only works for its own Org,
# so with TS_SECRET_KEY use the key from the Org that holds the Liveboard and model.
TS_ORG_ID=

# "(Sample) Retail - Apparel" model in the Eski-Test1 Org
# (data source behind the "Retail Sales Performance" Liveboard). Keep in sync with app/.env.
MODEL_ID=cd252e5c-b552-49a8-821d-3eadaa049cca

# Spotter MCP Server, bearer-token endpoint. Pin api-version to a date for production.
MCP_URL=https://agent.thoughtspot.app/token/mcp?api-version=latest

PORT=4000
