# Copy to .env. EXPO_PUBLIC_* values are compiled into the app bundle:
# IDs and URLs only, never secrets (those live in server/.env).
EXPO_PUBLIC_TS_HOST=https://se-thoughtspot-cloud.thoughtspot.cloud

# "Retail Sales Performance" Liveboard in the Eski-Test1 Org (single tab, so no tab ID)
EXPO_PUBLIC_LIVEBOARD_ID=bb849802-f90f-4b84-bf9c-3f39cc14f40b
EXPO_PUBLIC_LIVEBOARD_TAB_ID=

# "(Sample) Retail - Apparel" model. Keep in sync with MODEL_ID in server/.env.
EXPO_PUBLIC_MODEL_ID=cd252e5c-b552-49a8-821d-3eadaa049cca

# HTTPS URL of assets/brand/northpeak-icon-sprite.svg (Northpeak logo in place of
# Spotter's icon). Empty: Spotter keeps its own icon. See src/config.ts.
EXPO_PUBLIC_ICON_SPRITE_URL=

# Leave empty in development: the app uses your laptop's IP on port 4000.
EXPO_PUBLIC_BACKEND_URL=
